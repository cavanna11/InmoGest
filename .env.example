# =============================================================================
# InmoGest — variables de entorno. Copiar a .env.local y completar.
# Nunca commitear valores reales. Las variables NEXT_PUBLIC_* llegan al navegador:
# nunca poner secretos ahí. Detalle en docs/SECURITY.md y docs/DEPLOYMENT.md.
# =============================================================================

APP_ENV=local

# --- Aplicación ---
# URL pública de la app (panel y páginas de propiedades)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=InmoGest

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_…). Pública por diseño; la seguridad depende de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…). SALTEA RLS: solo servidor (webhooks) y worker.
SUPABASE_SECRET_KEY=

# --- Evolution API (WhatsApp por QR) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Worker ---
# Identificador de este proceso en los logs y en la toma de jobs
WORKER_ID=

# --- Herramientas de desarrollo (no se usan en runtime) ---
# Connection string del proyecto Supabase de DESARROLLO (Connect → Session pooler).
# Lo usan npm run db:push y npm run test:db.
SUPABASE_DB_URL=
