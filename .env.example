# =============================================================================
# InmoPanel by C&C — variables de entorno. Copiar a .env.local y completar.
# Nunca commitear valores reales. Las variables NEXT_PUBLIC_* llegan al navegador:
# nunca poner secretos ahí. Detalle en docs/SECURITY.md y docs/DEPLOYMENT.md.
# =============================================================================

APP_ENV=local

# --- Aplicación ---
# URL pública de la app (panel y páginas de propiedades). El dominio previsto inmopanel.com.ar
# todavía no está comprado: no usarlo hasta configurarlo (docs/DEPLOYMENT.md).
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=InmoPanel

# --- Supabase (Project Settings → API Keys) ---
# URL del proyecto, SOLO el origen: https://<ref>.supabase.co (sin /rest/v1).
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_…). Pública por diseño; la seguridad depende de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_…). SALTEA RLS: solo servidor (webhooks) y worker.
SUPABASE_SECRET_KEY=

# --- Evolution API (WhatsApp por QR) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Worker ---
# Identificador de este proceso en los logs y en la toma de jobs
WORKER_ID=

# --- Herramientas de desarrollo (no se usan en runtime) ---
# Connection string del proyecto Supabase de DESARROLLO (Connect → Method: Session pooler, puerto 5432).
# Lo usan npm run db:push, db:types y test:db. Caracteres especiales de la contraseña codificados para URL.
SUPABASE_DB_URL=
# Ruta (relativa a la raíz) al certificado CA de Supabase, necesario para test:db (Node no lo trae).
# Descargarlo de Project Settings → Database → SSL Configuration en certs/ (ignorada por Git).
SUPABASE_DB_CA_PATH=

# Opcional: puerto del servidor que levanta Playwright para los E2E (por defecto 3100).
E2E_PORT=
