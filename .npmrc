# Configuración de npm del proyecto: debe funcionar igual en Windows, Linux (CI, Vercel) y macOS.
#
# Windows: la ruta del proyecto contiene "&" (C&C), que rompe los atajos .cmd de npm. Cada
# desarrollador en Windows configura Git Bash como shell de scripts EN SU npm DE USUARIO (no acá:
# esa ruta no existe en Linux y rompe el build de Vercel):
#   npm config set script-shell "C:/Program Files/Git/bin/bash.exe" --location=user
# y usa siempre `npm run <script>`, nunca `npx`. Ver README.md.
engine-strict=true
save-exact=true
