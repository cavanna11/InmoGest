# Copiar como .env en el VPS (nunca al repositorio) y completar.
# Subdominio que apunta a este VPS. Hace falta para el certificado TLS.
EVOLUTION_DOMAIN=
# Clave larga y aleatoria, por ejemplo: openssl rand -hex 32. La misma va en Vercel.
EVOLUTION_API_KEY=
# Otra clave aleatoria, solo para el Postgres de Evolution.
EVOLUTION_DB_PASSWORD=
# Las mismas de la app. La clave secreta nunca va al navegador.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
